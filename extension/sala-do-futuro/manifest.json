{
  "manifest_version": 3,
  "name": "NEX — Agente de Navegador",
  "description": "Conecta o NEX AI à aba HTTPS autorizada pelo usuário.",
  "version": "1.4.0",
  "minimum_chrome_version": "111",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://nex-ai-preview-git-feat-nex-browser-agent-araujxs22-8685.vercel.app/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Controlar página com NEX",
    "default_popup": "popup.html"
  }
}